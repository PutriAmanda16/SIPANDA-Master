@model IEnumerable<Sipanda.Models.Entities.MasterUser>
@{
    ViewData["Title"] = "Master User";
    string? keyword = ViewData["Keyword"] as string;
    int? roleId = ViewData["RoleId"] as int?;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master User / Pengguna</h2>
        <p class="page-subtitle">Kelola akun login petugas, role hak akses, dan status keaktifan pengguna</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-controller="MasterRole" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-shield-lock-fill"></i> Kelola Master Role
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Tambah User Baru
        </a>
    </div>
</div>

<!-- Filter Section -->
<form method="get" asp-action="Index" class="filter-box">
    <div class="filter-grid">
        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-search"></i> Cari Username / Nama / Email</label>
            <input type="text" name="keyword" class="form-control" placeholder="Ketik kata kunci..." value="@keyword" />
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-shield-check"></i> Filter Role</label>
            <select name="roleId" class="form-select" asp-items="ViewBag.RoleList">
                <option value="">-- Semua Role --</option>
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
                <i class="bi bi-funnel-fill"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-people" style="color: var(--primary);"></i> Daftar Master User (@Model.Count() User)</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Username & Nama Lengkap</th>
                        <th>Role / Hak Akses</th>
                        <th>Unit SKPD / Faskes</th>
                        <th>Status</th>
                        <th>Terdaftar</th>
                        <th style="width: 140px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>
                                    <div style="font-weight: 700; color: #0f172a;">@item.Username</div>
                                    <div style="font-size: 0.82rem; color: #475569;">@item.NamaLengkap</div>
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <small style="color: #94a3b8;"><i class="bi bi-envelope"></i> @item.Email</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-primary" style="font-size: 0.8rem;">
                                        <i class="bi bi-shield-fill"></i> @(item.Role?.NamaRole ?? "-")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Faskes != null)
                                    {
                                        <div><span class="badge badge-secondary"><i class="bi bi-hospital"></i> @item.Faskes.NamaFaskes</span></div>
                                    }
                                    @if (item.Skpd != null)
                                    {
                                        <div style="font-size: 0.78rem; color: #64748b; margin-top: 0.2rem;"><i class="bi bi-building"></i> @item.Skpd.NamaSkpd</div>
                                    }
                                    @if (item.Faskes == null && item.Skpd == null)
                                    {
                                        <span style="color: #94a3b8; font-size: 0.8rem;">Umum / Pusat</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "aktif")
                                    {
                                        <span class="badge badge-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <small style="color: #64748b;">@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: inline-flex; gap: 0.35rem;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit Pengguna">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus user ini?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 2.5rem; color: #94a3b8;">
                                Tidak ada data pengguna yang cocok.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
