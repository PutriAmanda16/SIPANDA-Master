@model Sipanda.Models.Entities.MasterKategori
@{
    ViewData["Title"] = "Edit Kategori";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Edit Kategori Layanan</h2>
        <p class="page-subtitle">Perbarui nama kategori atau relasi induk (parent)</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="NamaKategori" class="form-label"></label>
                <input asp-for="NamaKategori" class="form-control" />
                <span asp-validation-for="NamaKategori" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="ParentId" class="form-label">Kategori Induk (Kosongkan jika ini Kategori Induk)</label>
                <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentId">
                    <option value="">-- Tanpa Induk (Sebagai Kategori Induk) --</option>
                </select>
                <span asp-validation-for="ParentId" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Simpan Perubahan
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
