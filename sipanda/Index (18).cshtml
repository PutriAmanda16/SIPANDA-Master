@model IEnumerable<Sipanda.Models.Entities.MasterRole>
@using Sipanda.Helpers
@{
    ViewData["Title"] = "Master Role & Hak Akses";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Role & Hak Akses Menu</h2>
        <p class="page-subtitle">Atur izin dan daftar menu apa saja yang dapat diakses oleh setiap kelompok pengguna</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-controller="MasterUser" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-people-fill"></i> Kelola Master User
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-shield-plus"></i> Tambah Role Baru
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-shield-lock" style="color: var(--primary);"></i> Daftar Master Role Pengguna</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 180px;">Nama Role</th>
                        <th>Deskripsi</th>
                        <th>Menu yang Diizinkan</th>
                        <th style="width: 110px; text-align: center;">Jumlah User</th>
                        <th style="width: 140px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                <span class="badge badge-primary" style="font-size: 0.85rem;">@item.NamaRole</span>
                            </td>
                            <td style="color: #475569; font-size: 0.85rem;">@item.Deskripsi</td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
                                    @foreach (var mKey in item.MenuKeyList)
                                    {
                                        var label = AppMenus.AllMenus.ContainsKey(mKey) ? AppMenus.AllMenus[mKey] : mKey;
                                        <span class="badge badge-secondary" style="font-size: 0.72rem;">@label</span>
                                    }
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <span class="badge badge-success">@item.UserList.Count User</span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; gap: 0.35rem;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit Hak Akses">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    @if (item.Id != 1)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus role ini?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
