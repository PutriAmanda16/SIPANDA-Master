@model IEnumerable<Sipanda.Models.Entities.MasterFaskes>
@{
    ViewData["Title"] = "Master Fasilitas Kesehatan";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Fasilitas Kesehatan (Faskes)</h2>
        <p class="page-subtitle">Kelola unit kerja fasilitas kesehatan dan pemetaan rekening retribusi</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Faskes
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-hospital" style="color: var(--accent);"></i> Daftar Fasilitas Kesehatan</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 150px;">Kode Faskes</th>
                        <th>Nama Fasilitas Kesehatan</th>
                        <th>Rekening Pendapatan</th>
                        <th>Jumlah Tarif Terdaftar</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td><span class="badge badge-primary">@item.KodeFaskes</span></td>
                            <td style="font-weight: 700; color: #0f172a;">@item.NamaFaskes</td>
                            <td>
                                <div><code style="font-size: 0.75rem;">@item.Rekening?.KodeRekening</code></div>
                                <div style="font-size: 0.8rem; color: #64748b;">@item.Rekening?.NamaRekening</div>
                            </td>
                            <td>
                                <span class="badge badge-success">@item.TarifList.Count.ToString("N0") Tarif</span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; gap: 0.35rem;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus Faskes ini?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
