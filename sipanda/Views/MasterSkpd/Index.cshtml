@model IEnumerable<Sipanda.Models.Entities.MasterSkpd>
@{
    ViewData["Title"] = "Master SKPD / OPD";
    string? keyword = ViewData["Keyword"] as string;
    int? parentFilter = ViewData["ParentFilter"] as int?;
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    int totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master SKPD & Unit Kerja (Hierarki OPD)</h2>
        <p class="page-subtitle">Daftar Satuan Kerja Perangkat Daerah (Induk) & Unit Pelaksana Teknis (Puskesmas, Labkesda, dll) Pemerintah Kota Surabaya</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Tambah OPD / Unit
        </a>
    </div>
</div>

<!-- Search & Filter Box -->
<form method="get" asp-action="Index" class="filter-box">
    <div class="filter-grid">
        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-search"></i> Cari Kode atau Nama OPD / Unit</label>
            <input type="text" name="keyword" class="form-control" placeholder="Contoh: Puskesmas, Dinas Kesehatan, dll..." value="@keyword" />
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-diagram-3"></i> Filter Hierarki OPD</label>
            <select name="parentFilter" class="form-select">
                <option value="" selected="@(parentFilter == null)">-- Semua OPD & Unit Kerja --</option>
                <option value="0" selected="@(parentFilter == 0)">-- Hanya OPD Induk (Level 1) --</option>
                @if (ViewBag.ParentList != null)
                {
                    @foreach (var p in (SelectList)ViewBag.ParentList)
                    {
                        <option value="@p.Value" selected="@(parentFilter?.ToString() == p.Value)">Unit di bawah: @p.Text</option>
                    }
                }
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
                <i class="bi bi-funnel-fill"></i> Terapkan Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <div style="font-size: 0.9rem; color: #64748b;">
            Menampilkan <strong style="color: #0f172a;">@Model.Count()</strong> dari total <strong style="color: #0f172a;">@totalItems.ToString("N0")</strong> SKPD / Unit Kerja
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 170px;">Kode OPD / Unit</th>
                        <th>Status Induk / Parent</th>
                        <th>Nama SKPD / Unit Kerja</th>
                        <th style="width: 130px; text-align: center;">Jumlah Unit</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td>
                                    <span class="badge badge-primary">@item.KodeSkpd</span>
                                </td>
                                <td>
                                    @if (item.Parent != null)
                                    {
                                        <span class="badge badge-secondary">
                                            <i class="bi bi-arrow-return-right"></i> @item.Parent.NamaSkpd
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">
                                            <i class="bi bi-building-fill"></i> OPD Induk (Level 1)
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #0f172a;">@item.NamaSkpd</div>
                                </td>
                                <td style="text-align: center;">
                                    @if (item.ParentId == null)
                                    {
                                        if (item.SubSkpdList.Any())
                                        {
                                            <span class="badge badge-primary" style="font-weight: 700;">
                                                @item.SubSkpdList.Count Unit
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: #94a3b8; font-size: 0.75rem;">-</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary" style="font-size: 0.72rem;">Unit Pelaksana</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: inline-flex; gap: 0.35rem;">
                                        @if (item.ParentId == null)
                                        {
                                            <a asp-action="Create" asp-route-parentId="@item.Id" class="btn btn-accent btn-sm" title="Tambah Unit Kerja / Puskesmas di bawah @item.NamaSkpd">
                                                <i class="bi bi-node-plus"></i>
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus SKPD / Unit ini?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2.5rem; color: #94a3b8;">
                                Tidak ada data SKPD / Unit Kerja yang cocok dengan pencarian Anda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="pagination-wrapper">
        <div style="font-size: 0.85rem; color: #64748b;">
            Halaman <strong>@currentPage</strong> dari <strong>@totalPages</strong>
        </div>

        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@keyword" 
                       asp-route-parentFilter="@parentFilter" 
                       asp-route-page="1"><i class="bi bi-chevron-double-left"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@keyword" 
                       asp-route-parentFilter="@parentFilter" 
                       asp-route-page="@(currentPage - 1)"><i class="bi bi-chevron-left"></i></a>
                </li>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@keyword" 
                       asp-route-parentFilter="@parentFilter" 
                       asp-route-page="@p">@p</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@keyword" 
                       asp-route-parentFilter="@parentFilter" 
                       asp-route-page="@(currentPage + 1)"><i class="bi bi-chevron-right"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@keyword" 
                       asp-route-parentFilter="@parentFilter" 
                       asp-route-page="@totalPages"><i class="bi bi-chevron-double-right"></i></a>
                </li>
            }
        </ul>
    </div>
}
