@model Sipanda.Models.Entities.MasterSkpd
@{
    ViewData["Title"] = "Edit SKPD / OPD";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Edit SKPD / Unit Kerja</h2>
        <p class="page-subtitle">Perbarui data kode dan nama perangkat daerah</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="KodeSkpd" class="form-label"></label>
                <input asp-for="KodeSkpd" class="form-control" />
                <span asp-validation-for="KodeSkpd" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NamaSkpd" class="form-label"></label>
                <input asp-for="NamaSkpd" class="form-control" />
                <span asp-validation-for="NamaSkpd" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="ParentId" class="form-label">OPD Induk (Opsional)</label>
                <select asp-for="ParentId" class="form-control" asp-items="ViewBag.ParentId">
                    <option value="">-- Tidak Ada / OPD Tingkat Utama (Level 1) --</option>
                </select>
                <span asp-validation-for="ParentId" style="color: var(--danger); font-size: 0.75rem;"></span>
                <small style="color: var(--text-muted); font-size: 0.75rem;">Pilih OPD Induk jika unit ini merupakan anak instansi / Puskesmas di bawah Dinas.</small>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Simpan Perubahan
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
