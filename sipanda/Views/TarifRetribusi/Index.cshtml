@model Sipanda.Models.ViewModels.TarifFilterViewModel
@{
    ViewData["Title"] = "Kelola Tarif Retribusi";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Manajemen Tabel Retribusi</h2>
        <p class="page-subtitle">Kelola besaran tarif, status keaktifan, dan dasar peraturan retribusi pelayanan kesehatan</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Tarif Baru
    </a>
</div>

<!-- Filter Section -->
<form method="get" asp-action="Index" class="filter-box">
    <div class="filter-grid">
        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-search"></i> Kata Kunci Layanan / Kategori</label>
            <input type="text" name="keyword" class="form-control" placeholder="Cari nama layanan..." value="@Model.Keyword" />
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-hospital"></i> Fasilitas Kesehatan</label>
            <select name="faskesId" class="form-select">
                <option value="">-- Semua Faskes --</option>
                @foreach (var f in Model.AvailableFaskes)
                {
                    <option value="@f.Id" selected="@(Model.FaskesId == f.Id)">@f.NamaFaskes (@f.KodeFaskes)</option>
                }
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-diagram-3"></i> Kategori Layanan</label>
            <select name="kategoriId" class="form-select">
                <option value="">-- Semua Kategori --</option>
                @foreach (var k in Model.AvailableKategori)
                {
                    <option value="@k.Id" selected="@(Model.KategoriId == k.Id)">@k.NamaKategori</option>
                }
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-toggle-on"></i> Status</label>
            <select name="status" class="form-select">
                <option value="">-- Semua Status --</option>
                <option value="aktif" selected="@(Model.Status == "aktif")">Aktif</option>
                <option value="tidak aktif" selected="@(Model.Status == "tidak aktif")">Tidak Aktif</option>
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
                <i class="bi bi-funnel-fill"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <div style="font-size: 0.9rem; color: #64748b;">
            Menampilkan <strong style="color: #0f172a;">@Model.Items.Count</strong> dari total <strong style="color: #0f172a;">@Model.TotalItems.ToString("N0")</strong> data tarif
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Fasilitas Kesehatan</th>
                        <th>Kategori & Sub Kategori</th>
                        <th>Nama Layanan / Tindakan</th>
                        <th>Satuan</th>
                        <th>Nominal Tarif</th>
                        <th>Mulai Berlaku</th>
                        <th>Status</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.TarifId</td>
                                <td>
                                    <span class="badge badge-primary">@item.KodeFaskes</span>
                                    <div style="font-size: 0.8rem; color: #64748b; margin-top: 0.15rem;">@item.NamaFaskes</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.KelompokKategori) && item.KelompokKategori != item.NamaKategori)
                                    {
                                        <div style="font-size: 0.72rem; color: #64748b; font-weight: 600; text-transform: uppercase;">@item.KelompokKategori</div>
                                    }
                                    <div style="font-weight: 500; color: #1e293b;">@item.NamaKategori</div>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #0f172a;">@item.NamaKomponen</div>
                                    <small style="color: #94a3b8;">@item.JenisPeraturan @item.NoPeraturan/@item.Tahun</small>
                                </td>
                                <td>
                                    <span class="badge badge-secondary">@(item.Satuan ?? "Per Layanan")</span>
                                </td>
                                <td class="text-currency" style="font-size: 0.95rem; color: #0284c7; font-weight: 700;">
                                    Rp @item.Harga.ToString("N0")
                                </td>
                                <td>
                                    <span style="font-size: 0.8rem; color: #475569;">@item.TanggalMulai.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    @if (item.Status == "aktif")
                                    {
                                        <span class="badge badge-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">@item.Status</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: inline-flex; gap: 0.35rem;">
                                        <a asp-action="Edit" asp-route-id="@item.TarifId" class="btn btn-secondary btn-sm" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.TarifId" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data tarif ini?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" style="text-align: center; padding: 3rem; color: #94a3b8;">
                                <i class="bi bi-search" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; color: #cbd5e1;"></i>
                                Tidak ada data tarif yang cocok.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="pagination-wrapper">
        <div style="font-size: 0.85rem; color: #64748b;">
            Halaman <strong>@Model.PageNumber</strong> dari <strong>@Model.TotalPages</strong>
        </div>

        <ul class="pagination">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@Model.Keyword" 
                       asp-route-faskesId="@Model.FaskesId" 
                       asp-route-kategoriId="@Model.KategoriId" 
                       asp-route-status="@Model.Status" 
                       asp-route-page="1"><i class="bi bi-chevron-double-left"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@Model.Keyword" 
                       asp-route-faskesId="@Model.FaskesId" 
                       asp-route-kategoriId="@Model.KategoriId" 
                       asp-route-status="@Model.Status" 
                       asp-route-page="@(Model.PageNumber - 1)"><i class="bi bi-chevron-left"></i></a>
                </li>
            }

            @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@Model.Keyword" 
                       asp-route-faskesId="@Model.FaskesId" 
                       asp-route-kategoriId="@Model.KategoriId" 
                       asp-route-status="@Model.Status" 
                       asp-route-page="@p">@p</a>
                </li>
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@Model.Keyword" 
                       asp-route-faskesId="@Model.FaskesId" 
                       asp-route-kategoriId="@Model.KategoriId" 
                       asp-route-status="@Model.Status" 
                       asp-route-page="@(Model.PageNumber + 1)"><i class="bi bi-chevron-right"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-keyword="@Model.Keyword" 
                       asp-route-faskesId="@Model.FaskesId" 
                       asp-route-kategoriId="@Model.KategoriId" 
                       asp-route-status="@Model.Status" 
                       asp-route-page="@Model.TotalPages"><i class="bi bi-chevron-double-right"></i></a>
                </li>
            }
        </ul>
    </div>
}
