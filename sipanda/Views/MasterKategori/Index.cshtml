@model IEnumerable<Sipanda.Models.Entities.MasterKategori>
@{
    ViewData["Title"] = "Master Kategori";
    int? currentFilter = ViewData["CurrentFilter"] as int?;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Kategori & Sub-Kategori Layanan</h2>
        <p class="page-subtitle">Kelola struktur hierarki kategori pelayanan kesehatan</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Tambah Kategori
        </a>
    </div>
</div>

<!-- Filter Hierarki -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body" style="padding: 1rem 1.5rem;">
        <form method="get" asp-action="Index" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <label style="font-size: 0.85rem; font-weight: 600; color: #475569;">Filter Tampilan:</label>
            <select name="parentFilter" class="form-select" style="max-width: 300px;" onchange="this.form.submit()">
                <option value="" selected="@(currentFilter == null)">-- Semua Kategori & Sub-Kategori --</option>
                <option value="0" selected="@(currentFilter == 0)">-- Hanya Kategori Induk (Parent) --</option>
                @if (ViewBag.ParentList != null)
                {
                    @foreach (var p in (SelectList)ViewBag.ParentList)
                    {
                        <option value="@p.Value" selected="@(currentFilter?.ToString() == p.Value)">Sub dari: @p.Text</option>
                    }
                }
            </select>
            @if (currentFilter != null)
            {
                <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="bi bi-x-circle"></i> Reset Filter</a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-diagram-3" style="color: var(--warning);"></i> Daftar Kategori</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Kategori Induk (Parent)</th>
                        <th>Nama Kategori / Sub-Kategori</th>
                        <th>Jumlah Sub / Komponen</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                @if (item.Parent != null)
                                {
                                    <span class="badge badge-primary"><i class="bi bi-arrow-return-right"></i> @item.Parent.NamaKategori</span>
                                }
                                else
                                {
                                    <span class="badge badge-success"><i class="bi bi-folder-fill"></i> Kategori Induk</span>
                                }
                            </td>
                            <td>
                                <div style="font-weight: 700; color: #0f172a;">@item.NamaKategori</div>
                            </td>
                            <td>
                                @if (item.ParentId == null)
                                {
                                    <span class="badge badge-secondary">@item.SubKategoriList.Count Sub-Kategori</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">@item.KomponenList.Count Komponen</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; gap: 0.35rem;">
                                    @if (item.ParentId == null)
                                    {
                                        <a asp-action="Create" asp-route-parentId="@item.Id" class="btn btn-accent btn-sm" title="Tambah Sub Kategori">
                                            <i class="bi bi-node-plus"></i>
                                        </a>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori ini?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
