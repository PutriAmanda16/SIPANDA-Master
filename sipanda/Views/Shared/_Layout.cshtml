@using Sipanda.Helpers
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIPANDA Kota Surabaya</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar">
            <div class="sidebar-header">
                <div class="brand-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="brand-text">
                    <h1>SIPANDA</h1>
                    <p>Retribusi Kesehatan</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Menu Utama</div>
                
                @if (User.HasMenuAccess(AppMenus.Dashboard))
                {
                    <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard Utama</span>
                    </a>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-section-title" style="margin-top: 1rem;">Perencanaan & Budgeting</div>
                    @if (User.HasMenuAccess(AppMenus.BudgetPendapatan))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "BudgetPendapatan" ? "active" : "")" 
                           asp-controller="BudgetPendapatan" asp-action="Index">
                            <i class="bi bi-calculator-fill"></i>
                            <span>Budgeting Pendapatan</span>
                        </a>
                    }

                    <div class="nav-section-title" style="margin-top: 1rem;">Administrasi & Master</div>

                    @if (User.HasMenuAccess(AppMenus.TarifRetribusi))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "TarifRetribusi" ? "active" : "")" 
                           asp-controller="TarifRetribusi" asp-action="Index">
                            <i class="bi bi-receipt"></i>
                            <span>Tabel Retribusi</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterPeraturan))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterPeraturan" ? "active" : "")" 
                           asp-controller="MasterPeraturan" asp-action="Index">
                            <i class="bi bi-journal-text"></i>
                            <span>Master Peraturan</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterSkpd))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterSkpd" ? "active" : "")" 
                           asp-controller="MasterSkpd" asp-action="Index">
                            <i class="bi bi-building"></i>
                            <span>Master SKPD / OPD</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterFaskes))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterFaskes" ? "active" : "")" 
                           asp-controller="MasterFaskes" asp-action="Index">
                            <i class="bi bi-hospital"></i>
                            <span>Master Faskes</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterRekening))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterRekening" ? "active" : "")" 
                           asp-controller="MasterRekening" asp-action="Index">
                            <i class="bi bi-cash-stack"></i>
                            <span>Master Rekening</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterKategori))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterKategori" ? "active" : "")" 
                           asp-controller="MasterKategori" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Master Kategori</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.MasterKomponen))
                    {
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterKomponen" ? "active" : "")" 
                           asp-controller="MasterKomponen" asp-action="Index">
                            <i class="bi bi-bandaid"></i>
                            <span>Master Layanan/Komponen</span>
                        </a>
                    }

                    @if (User.HasMenuAccess(AppMenus.UserManagement))
                    {
                        <div class="nav-section-title" style="margin-top: 1rem;">Pengaturan Sistem</div>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterUser" ? "active" : "")" 
                           asp-controller="MasterUser" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Master User</span>
                        </a>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MasterRole" ? "active" : "")" 
                           asp-controller="MasterRole" asp-action="Index">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Master Role</span>
                        </a>
                    }
                }
                else
                {
                    <div class="nav-section-title" style="margin-top: 1rem;">Petugas / Admin</div>
                    <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")" 
                       asp-controller="Account" asp-action="Login">
                        <i class="bi bi-lock-fill"></i>
                        <span>Login Petugas / Admin</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div style="font-weight: 600; color: #cbd5e1;">Perda No. 7 Th. 2023</div>
                <div style="font-size: 0.7rem; color: #94a3b8;">Pemerintah Kota Surabaya</div>
            </div>
        </aside>

        <!-- Main Body -->
        <div class="app-main">
            <!-- Top Navbar -->
            <header class="top-navbar no-print">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span style="font-weight: 700; color: #0f172a; font-size: 0.95rem;">
                        <i class="bi bi-geo-alt-fill text-primary" style="color: var(--primary);"></i> Sistem Informasi Pendapatan Daerah - Retribusi Pelayanan Kesehatan
                    </span>
                </div>

                <div class="nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <span class="badge badge-primary">
                                <i class="bi bi-shield-fill"></i> @User.FindFirst("RoleName")?.Value
                            </span>
                            <span class="badge badge-success">
                                <i class="bi bi-person-check-fill"></i> @(User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name)
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-secondary btn-sm" title="Keluar">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Login Admin
                        </a>
                    }
                </div>
            </header>

            <!-- Alerts -->
            <div class="content-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill" style="font-size: 1.2rem;"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.2rem;"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
