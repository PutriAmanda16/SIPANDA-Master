@model IEnumerable<Sipanda.Models.Entities.MasterKomponen>
@{
    ViewData["Title"] = "Master Layanan / Komponen";
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    int totalItems = (int)(ViewData["TotalItems"] ?? 0);
    string? keyword = ViewData["Keyword"] as string;
    int? kategoriId = ViewData["KategoriId"] as int?;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Layanan / Komponen Medis</h2>
        <p class="page-subtitle">Kelola nama-nama tindakan medis, paket layanan, dan satuannya</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Layanan
    </a>
</div>

<!-- Search & Filter -->
<form method="get" asp-action="Index" class="filter-box">
    <div class="filter-grid">
        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-search"></i> Cari Nama Layanan / Satuan</label>
            <input type="text" name="keyword" class="form-control" placeholder="Ketik kata kunci..." value="@keyword" />
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label"><i class="bi bi-diagram-3"></i> Filter Kategori</label>
            <select name="kategoriId" class="form-select" asp-items="ViewBag.KategoriList">
                <option value="">-- Semua Kategori --</option>
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">
                <i class="bi bi-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Reset">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <div style="font-size: 0.9rem; color: #64748b;">
            Total <strong style="color: #0f172a;">@totalItems.ToString("N0")</strong> Komponen Layanan
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Kategori</th>
                        <th>Nama Layanan / Tindakan</th>
                        <th>Satuan</th>
                        <th>Terhubung Tarif</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>
                                    @if (item.Kategori?.Parent != null)
                                    {
                                        <div style="font-size: 0.72rem; color: #64748b; font-weight: 600;">@item.Kategori.Parent.NamaKategori</div>
                                    }
                                    <span class="badge badge-secondary">@item.Kategori?.NamaKategori</span>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #0f172a;">@item.NamaKomponen</div>
                                </td>
                                <td>
                                    <span class="badge badge-primary">@(item.Satuan ?? "-")</span>
                                </td>
                                <td>
                                    <span class="badge badge-success">@item.TarifList.Count Tarif</span>
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: inline-flex; gap: 0.35rem;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus komponen ini?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2.5rem; color: #94a3b8;">
                                Tidak ada data layanan yang cocok.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="pagination-wrapper">
        <div style="font-size: 0.85rem; color: #64748b;">
            Halaman <strong>@currentPage</strong> dari <strong>@totalPages</strong>
        </div>

        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@keyword" asp-route-kategoriId="@kategoriId" asp-route-page="1"><i class="bi bi-chevron-double-left"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@keyword" asp-route-kategoriId="@kategoriId" asp-route-page="@(currentPage - 1)"><i class="bi bi-chevron-left"></i></a>
                </li>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@keyword" asp-route-kategoriId="@kategoriId" asp-route-page="@p">@p</a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@keyword" asp-route-kategoriId="@kategoriId" asp-route-page="@(currentPage + 1)"><i class="bi bi-chevron-right"></i></a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@keyword" asp-route-kategoriId="@kategoriId" asp-route-page="@totalPages"><i class="bi bi-chevron-double-right"></i></a>
                </li>
            }
        </ul>
    </div>
}
