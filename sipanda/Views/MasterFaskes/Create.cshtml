@model Sipanda.Models.Entities.MasterFaskes
@{
    ViewData["Title"] = "Tambah Fasilitas Kesehatan";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Tambah Fasilitas Kesehatan (Faskes)</h2>
        <p class="page-subtitle">Masukkan unit kerja faskes baru dan hubungkan ke rekening pendapatan</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="KodeFaskes" class="form-label"></label>
                <input asp-for="KodeFaskes" class="form-control" placeholder="Contoh: PUSKESMAS, LABKESDA, RSUD, BDRS" />
                <span asp-validation-for="KodeFaskes" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NamaFaskes" class="form-label"></label>
                <input asp-for="NamaFaskes" class="form-control" placeholder="Contoh: Pelayanan Kesehatan Puskesmas" />
                <span asp-validation-for="NamaFaskes" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="RekeningId" class="form-label"></label>
                <select asp-for="RekeningId" class="form-select" asp-items="ViewBag.RekeningId">
                    <option value="">-- Pilih Rekening Pendapatan --</option>
                </select>
                <span asp-validation-for="RekeningId" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Simpan Faskes
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
