@model Sipanda.Models.Entities.BudgetPendapatan
@{
    Layout = null;
    var activeVersi = ViewBag.ActiveVersi as Sipanda.Models.Entities.BudgetPendapatanVersi;
    var items = activeVersi?.VersiDetailList.ToList() ?? new List<Sipanda.Models.Entities.BudgetPendapatanVersiDetail>();

    long totalTarget = items.Sum(i => i.NilaiTarget);
    long totalSemula = items.Sum(i => i.NilaiSemula);
    long totalSelisih = totalTarget - totalSemula;
    bool isPerubahan = Model.JenisAnggaran == "PERUBAHAN";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <title>RINCIAN PENGHITUNGAN - @Model.NomorUsulan</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #000;
            background: #fff;
            margin: 15mm 15mm 15mm 15mm;
        }
        .header-title {
            text-align: center;
            font-weight: bold;
            font-size: 14px;
            background-color: #d1d5db;
            padding: 8px;
            border: 1px solid #000;
            margin-bottom: 0;
            text-transform: uppercase;
        }
        .meta-table {
            width: 100%;
            border-collapse: collapse;
            border-left: 1px solid #000;
            border-right: 1px solid #000;
            border-bottom: 1px solid #000;
        }
        .meta-table td {
            padding: 4px 6px;
            vertical-align: top;
        }
        .section-header {
            background-color: #e5e7eb;
            font-weight: bold;
            text-align: center;
            padding: 5px;
            border-left: 1px solid #000;
            border-right: 1px solid #000;
            border-bottom: 1px solid #000;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: -1px;
        }
        .data-table th, .data-table td {
            border: 1px solid #000;
            padding: 4px 5px;
        }
        .data-table th {
            background-color: #f3f4f6;
            text-align: center;
            font-weight: bold;
        }
        .number {
            text-align: right;
            white-space: nowrap;
        }
        .center {
            text-align: center;
        }
        .bold {
            font-weight: bold;
        }
        .no-print {
            margin-bottom: 15px;
            text-align: right;
        }
        @@media print {
            .no-print { display: none; }
            body { margin: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()" style="padding: 8px 16px; background: #2563eb; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">
            🖨️ Cetak Dokumen
        </button>
    </div>

    <!-- HEADER TITLE -->
    <div class="header-title">RINCIAN PENGHITUNGAN PENDAPATAN DAERAH</div>

    <!-- METADATA TABLE -->
    <table class="meta-table">
        <tr>
            <td style="width: 180px;">Urusan Pemerintahan</td>
            <td>: (1) URUSAN PEMERINTAHAN WAJIB YANG BERKAITAN DENGAN PELAYANAN DASAR</td>
        </tr>
        <tr>
            <td>Organisasi</td>
            <td>: (@Model.Skpd?.KodeSkpd) @Model.Skpd?.NamaSkpd</td>
        </tr>
        <tr>
            <td>Program</td>
            <td>: @(Model.Program ?? "-")</td>
        </tr>
        <tr>
            <td>Kegiatan</td>
            <td>: @(Model.Kegiatan ?? "-")</td>
        </tr>
        <tr>
            <td>Sub Kegiatan</td>
            <td>: @(Model.SubKegiatan ?? "-")</td>
        </tr>
        <tr>
            <td>Tahun Anggaran</td>
            <td>: @Model.TahunAnggaran?.Tahun (Tahap: @Model.CurrentTahap?.NamaTahap - Versi: @(activeVersi?.NomorVersi ?? "V1.0"))</td>
        </tr>
        <tr>
            <td>Sumber Pendanaan</td>
            <td>: @(Model.SumberPendanaan ?? "Pendapatan Asli Daerah (PAD)")</td>
        </tr>
    </table>

    <!-- INDIKATOR KINERJA HEADER -->
    <div class="section-header">Indikator & Tolok Ukur Kinerja Pendapatan</div>
    <table class="data-table">
        <thead>
            <tr>
                <th rowspan="2">Indikator</th>
                <th colspan="2">Sebelum Perubahan</th>
                <th colspan="2">Setelah Perubahan</th>
            </tr>
            <tr>
                <th>Tolok Ukur Kinerja</th>
                <th>Target Kinerja</th>
                <th>Tolok Ukur Kinerja</th>
                <th>Target Kinerja</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Capaian Program</td>
                <td>Persentase Capaian Retribusi Daerah</td>
                <td class="center">90 %</td>
                <td>Persentase Capaian Retribusi Daerah</td>
                <td class="center">95 %</td>
            </tr>
            <tr>
                <td>Hasil</td>
                <td>Target Penerimaan Retribusi Daerah</td>
                <td class="number">Rp @totalSemula.ToString("N0")</td>
                <td>Target Penerimaan Retribusi Daerah</td>
                <td class="number">Rp @totalTarget.ToString("N0")</td>
            </tr>
        </tbody>
    </table>

    <!-- RINCIAN ANGGARAN TABLE -->
    <div class="section-header" style="margin-top: 10px;">Rincian Anggaran Pendapatan Satuan Kerja Perangkat Daerah</div>

    @if (isPerubahan)
    {
        <!-- FORMAT APBD PERUBAHAN (PAK) SEPERTI GAMBAR CONTOH -->
        <table class="data-table">
            <thead>
                <tr>
                    <th rowspan="2" style="width: 120px;">Kode Rekening</th>
                    <th rowspan="2">Uraian</th>
                    <th colspan="4">Sebelum Perubahan</th>
                    <th colspan="4">Setelah Perubahan</th>
                    <th rowspan="2" style="width: 110px;">Bertambah / (Berkurang)<br/>(Rp)</th>
                </tr>
                <tr>
                    <th style="width: 45px;">Volume</th>
                    <th style="width: 50px;">Satuan</th>
                    <th style="width: 75px;">Tarif Satuan</th>
                    <th style="width: 90px;">Jumlah (Rp)</th>

                    <th style="width: 45px;">Volume</th>
                    <th style="width: 50px;">Satuan</th>
                    <th style="width: 75px;">Tarif Satuan</th>
                    <th style="width: 90px;">Jumlah (Rp)</th>
                </tr>
                <tr style="font-size: 9px; color: #555;">
                    <th class="center">1</th>
                    <th class="center">2</th>
                    <th class="center">3</th>
                    <th class="center">4</th>
                    <th class="center">5</th>
                    <th class="center">6 = (3 x 5)</th>
                    <th class="center">7</th>
                    <th class="center">8</th>
                    <th class="center">9</th>
                    <th class="center">10 = (7 x 9)</th>
                    <th class="center">11 = (10 - 6)</th>
                </tr>
            </thead>
            <tbody>
                <tr class="bold">
                    <td>4</td>
                    <td>PENDAPATAN DAERAH</td>
                    <td colspan="4"></td>
                    <td colspan="4"></td>
                    <td class="number">@(totalSelisih >= 0 ? "+" : "")Rp @totalSelisih.ToString("N0")</td>
                </tr>
                <tr class="bold">
                    <td>4.1</td>
                    <td>PENDAPATAN ASLI DAERAH (PAD)</td>
                    <td colspan="4"></td>
                    <td colspan="4"></td>
                    <td class="number">@(totalSelisih >= 0 ? "+" : "")Rp @totalSelisih.ToString("N0")</td>
                </tr>
                <tr class="bold">
                    <td>4.1.02</td>
                    <td>Retribusi Daerah</td>
                    <td colspan="4"></td>
                    <td colspan="4"></td>
                    <td class="number">@(totalSelisih >= 0 ? "+" : "")Rp @totalSelisih.ToString("N0")</td>
                </tr>

                @foreach (var item in items)
                {
                    <tr>
                        <td>@(item.Detail?.Rekening?.KodeRekening ?? "-")</td>
                        <td>@item.UraianLayanan</td>

                        <!-- SEBELUM -->
                        <td class="center">@item.VolumeSemula.ToString("N0")</td>
                        <td class="center">@item.Satuan</td>
                        <td class="number">@item.TarifSemula.ToString("N0")</td>
                        <td class="number">@item.NilaiSemula.ToString("N0")</td>

                        <!-- SETELAH -->
                        <td class="center">@item.Volume.ToString("N0")</td>
                        <td class="center">@item.Satuan</td>
                        <td class="number">@item.TarifSatuan.ToString("N0")</td>
                        <td class="number">@item.NilaiTarget.ToString("N0")</td>

                        <!-- SELISIH -->
                        <td class="number bold">@(item.SelisihNilai >= 0 ? "+" : "")@item.SelisihNilai.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="bold" style="background-color: #f3f4f6;">
                    <td colspan="5" class="number">TOTAL SEBELUM:</td>
                    <td class="number">Rp @totalSemula.ToString("N0")</td>
                    <td colspan="3" class="number">TOTAL SETELAH:</td>
                    <td class="number">Rp @totalTarget.ToString("N0")</td>
                    <td class="number">@(totalSelisih >= 0 ? "+" : "")Rp @totalSelisih.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    }
    else
    {
        <!-- FORMAT APBD MURNI -->
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 140px;">Kode Rekening</th>
                    <th>Uraian</th>
                    <th style="width: 60px;">Volume</th>
                    <th style="width: 70px;">Satuan</th>
                    <th style="width: 100px;">Tarif Satuan (Rp)</th>
                    <th style="width: 130px;">Jumlah Target (Rp)</th>
                </tr>
            </thead>
            <tbody>
                <tr class="bold">
                    <td>4</td>
                    <td>PENDAPATAN DAERAH</td>
                    <td colspan="3"></td>
                    <td class="number">Rp @totalTarget.ToString("N0")</td>
                </tr>
                <tr class="bold">
                    <td>4.1</td>
                    <td>PENDAPATAN ASLI DAERAH (PAD)</td>
                    <td colspan="3"></td>
                    <td class="number">Rp @totalTarget.ToString("N0")</td>
                </tr>
                <tr class="bold">
                    <td>4.1.02</td>
                    <td>Retribusi Daerah</td>
                    <td colspan="3"></td>
                    <td class="number">Rp @totalTarget.ToString("N0")</td>
                </tr>

                @foreach (var item in items)
                {
                    <tr>
                        <td>@(item.Detail?.Rekening?.KodeRekening ?? "-")</td>
                        <td>@item.UraianLayanan</td>
                        <td class="center">@item.Volume.ToString("N0")</td>
                        <td class="center">@item.Satuan</td>
                        <td class="number">Rp @item.TarifSatuan.ToString("N0")</td>
                        <td class="number bold">Rp @item.NilaiTarget.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="bold" style="background-color: #f3f4f6; font-size: 12px;">
                    <td colspan="5" class="number">TOTAL PENDAPATAN DAERAH (MURNI):</td>
                    <td class="number">Rp @totalTarget.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    }
</body>
</html>
