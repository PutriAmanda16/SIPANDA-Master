@model IEnumerable<Sipanda.Models.Entities.BudgetPendapatan>
@{
    ViewData["Title"] = "Penganggaran Pendapatan Daerah";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
}

<div class="page-header">
    <div>
        <h2 class="page-title">Penganggaran Pendapatan (Budgeting)</h2>
        <p class="page-subtitle">Penyusunan target penerimaan daerah berbasis workflow, versioning, dan approval multi-tahap</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Buat Dokumen Usulan Baru
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- FILTER & SEARCH BAR -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <form method="get" asp-action="Index" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) 100px; gap: 1rem; align-items: flex-end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.75rem;">Tahun Anggaran</label>
                <select name="tahunId" class="form-control" asp-items="ViewBag.TahunId">
                    <option value="">-- Semua Tahun --</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.75rem;">SKPD / OPD</label>
                <select name="skpdId" class="form-control" asp-items="ViewBag.SkpdId">
                    <option value="">-- Semua SKPD --</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.75rem;">Jenis Anggaran</label>
                <select name="jenisAnggaran" class="form-control">
                    <option value="">-- Semua Jenis --</option>
                    <option value="MURNI" selected="@(ViewBag.SelectedJenis == "MURNI")">APBD Murni (Induk)</option>
                    <option value="PERGESERAN" selected="@(ViewBag.SelectedJenis == "PERGESERAN")">Pergeseran / Revisi</option>
                    <option value="PERUBAHAN" selected="@(ViewBag.SelectedJenis == "PERUBAHAN")">APBD Perubahan (PAK)</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.75rem;">Status</label>
                <select name="status" class="form-control">
                    <option value="">-- Semua Status --</option>
                    <option value="DRAFT" selected="@(ViewBag.SelectedStatus == "DRAFT")">Draft</option>
                    <option value="DIAJUKAN" selected="@(ViewBag.SelectedStatus == "DIAJUKAN")">Diajukan</option>
                    <option value="DISETUJUI" selected="@(ViewBag.SelectedStatus == "DISETUJUI")">Disetujui</option>
                    <option value="DIKEMBALIKAN" selected="@(ViewBag.SelectedStatus == "DIKEMBALIKAN")">Dikembalikan</option>
                    <option value="FINAL" selected="@(ViewBag.SelectedStatus == "FINAL")">Final (DPA)</option>
                </select>
            </div>

            <button type="submit" class="btn btn-secondary" style="height: 38px;">
                <i class="bi bi-filter"></i> Filter
            </button>
        </form>
    </div>
</div>

<!-- DATA TABLE -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div style="overflow-x: auto;">
            <table class="table" style="margin-bottom: 0;">
                <thead>
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Nomor Dokumen & OPD</th>
                        <th>Tahun</th>
                        <th>Jenis Anggaran</th>
                        <th>Tahapan Berjalan</th>
                        <th>Status</th>
                        <th style="text-align: right;">Total Target (Rp)</th>
                        <th style="text-align: center; width: 140px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                <i class="bi bi-folder-x" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; opacity: 0.5;"></i>
                                Belum ada dokumen usulan penganggaran pendapatan. Klik <strong>Buat Dokumen Usulan Baru</strong> untuk memulai.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int no = (currentPage - 1) * 15 + 1;
                        foreach (var item in Model)
                        {
                            var latestVersion = item.VersiList.OrderByDescending(v => v.Id).FirstOrDefault();
                            var totalNilai = latestVersion?.VersiDetailList.Sum(vd => vd.NilaiTarget) ?? 0;
                            var totalSemula = latestVersion?.VersiDetailList.Sum(vd => vd.NilaiSemula) ?? 0;
                            var selisih = totalNilai - totalSemula;

                            <tr>
                                <td>@no</td>
                                <td>
                                    <div style="font-weight: 600; color: var(--text-main);">@item.NomorUsulan</div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);"><i class="bi bi-building"></i> @item.Skpd?.NamaSkpd</div>
                                </td>
                                <td>
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-weight: 700;">
                                        TA @item.TahunAnggaran?.Tahun
                                    </span>
                                </td>
                                <td>
                                    @if (item.JenisAnggaran == "MURNI")
                                    {
                                        <span class="badge badge-success"><i class="bi bi-file-earmark-text"></i> MURNI</span>
                                    }
                                    else if (item.JenisAnggaran == "PERUBAHAN")
                                    {
                                        <span class="badge badge-warning"><i class="bi bi-arrow-repeat"></i> PAK / PERUBAHAN</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-info"><i class="bi bi-shuffle"></i> PERGESERAN</span>
                                    }
                                </td>
                                <td>
                                    <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-main);">
                                        @item.CurrentTahap?.NamaTahap
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">
                                        Tahap ke-@item.CurrentTahap?.Urutan • Versi @(latestVersion?.NomorVersi ?? "V1.0")
                                    </div>
                                </td>
                                <td>
                                    @if (item.StatusDokumen == "DRAFT")
                                    {
                                        <span class="badge badge-secondary">Draft</span>
                                    }
                                    else if (item.StatusDokumen == "DIAJUKAN")
                                    {
                                        <span class="badge badge-warning">Diajukan</span>
                                    }
                                    else if (item.StatusDokumen == "DISETUJUI")
                                    {
                                        <span class="badge badge-success">Disetujui</span>
                                    }
                                    else if (item.StatusDokumen == "DIKEMBALIKAN")
                                    {
                                        <span class="badge badge-danger">Dikembalikan</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-primary">DPA Final</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div style="font-weight: 700; color: #10b981; font-size: 0.95rem;">
                                        Rp @totalNilai.ToString("N0")
                                    </div>
                                    @if (item.JenisAnggaran == "PERUBAHAN" && totalSemula > 0)
                                    {
                                        <div style="font-size: 0.75rem; color: @(selisih >= 0 ? "#10b981" : "#ef4444");">
                                            @(selisih >= 0 ? "+" : "")Rp @selisih.ToString("N0")
                                        </div>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: flex; gap: 0.25rem; justify-content: center;">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Buka Canvas Penghitungan">
                                            <i class="bi bi-calculator"></i> Buka
                                        </a>
                                        <a asp-action="PrintRkaDpa" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-secondary" title="Cetak Format Standar">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            no++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
        <span style="font-size: 0.85rem; color: var(--text-muted);">
            Menampilkan halaman @currentPage dari @totalPages (Total @totalItems usulan)
        </span>
        <div style="display: flex; gap: 0.5rem;">
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(currentPage - 1)" class="btn btn-sm btn-secondary">
                    <i class="bi bi-chevron-left"></i> Sebelumnya
                </a>
            }
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-page="@(currentPage + 1)" class="btn btn-sm btn-secondary">
                    Selanjutnya <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}
