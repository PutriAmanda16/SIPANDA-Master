@model IEnumerable<Sipanda.Models.Entities.MasterPeraturan>
@{
    ViewData["Title"] = "Master Peraturan & Regulasi";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Regulasi & Dasar Hukum</h2>
        <p class="page-subtitle">Kelola daftar Peraturan Daerah (Perda), Peraturan Walikota (Perwali), atau SK penetapan tarif</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Peraturan
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-journal-text" style="color: var(--primary);"></i> Daftar Regulasi Retribusi</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 220px;">Jenis & Nomor Peraturan</th>
                        <th>Tentang / Uraian Regulasi</th>
                        <th>Tanggal Berlaku</th>
                        <th>Status</th>
                        <th>Jumlah Tarif</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                <div style="font-weight: 700; color: #0f172a;">@item.JudulLengkap</div>
                                <small style="color: #64748b;">Tahun @item.Tahun</small>
                            </td>
                            <td style="color: #334155; line-height: 1.4;">@item.Tentang</td>
                            <td>
                                <span style="font-weight: 600;">@item.TanggalBerlaku.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                @if (item.Status == "aktif")
                                {
                                    <span class="badge badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">@item.Status</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-primary">@item.TarifList.Count.ToString("N0") Tarif</span>
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; gap: 0.35rem;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus peraturan ini?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
