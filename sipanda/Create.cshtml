@model Sipanda.Models.Entities.BudgetPendapatan
@{
    ViewData["Title"] = "Buat Dokumen Usulan Anggaran";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Buat Dokumen Penganggaran Pendapatan</h2>
        <p class="page-subtitle">Inisiasi dokumen usulan target penerimaan daerah (APBD Murni / Pergeseran / PAK)</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 800px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label asp-for="TahunAnggaranId" class="form-label"></label>
                    <select asp-for="TahunAnggaranId" class="form-control" asp-items="ViewBag.TahunAnggaranId"></select>
                    <span asp-validation-for="TahunAnggaranId" style="color: var(--danger); font-size: 0.75rem;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="JenisAnggaran" class="form-label"></label>
                    <select asp-for="JenisAnggaran" class="form-control" id="selectJenisAnggaran" onchange="toggleDpaInduk()">
                        <option value="MURNI">APBD Murni (Penyusunan Awal / Induk)</option>
                        <option value="PERGESERAN">Pergeseran / Revisi Antar Rekening</option>
                        <option value="PERUBAHAN">APBD Perubahan (PAK - Perubahan Anggaran Keuangan)</option>
                    </select>
                    <span asp-validation-for="JenisAnggaran" style="color: var(--danger); font-size: 0.75rem;"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="SkpdId" class="form-label"></label>
                <select asp-for="SkpdId" class="form-control" asp-items="ViewBag.SkpdId"></select>
                <span asp-validation-for="SkpdId" style="color: var(--danger); font-size: 0.75rem;"></span>
                <small style="color: var(--text-muted); font-size: 0.75rem;">Pilih OPD Induk (contoh: Dinas Kesehatan) atau Unit Kerja / Puskesmas pengusul.</small>
            </div>

            <!-- DPA INDUK SELECTOR (HANYA MUNCUL JIKA PERUBAHAN/PAK) -->
            <div class="form-group" id="groupDpaInduk" style="display: none; background: rgba(245, 158, 11, 0.08); padding: 1rem; border-radius: 8px; border: 1px dashed rgba(245, 158, 11, 0.3);">
                <label asp-for="DpaIndukId" class="form-label" style="color: #d97706; font-weight: 700;">
                    <i class="bi bi-link-45deg"></i> Pilih Referensi DPA Murni (Baseline Semula)
                </label>
                <select asp-for="DpaIndukId" class="form-control" asp-items="ViewBag.DpaIndukList">
                    <option value="">-- Tanpa Referensi (Mulai dari Nol) --</option>
                </select>
                <small style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 0.25rem;">
                    Seluruh rincian penghitungan dari DPA Murni yang dipilih akan otomatis disalin menjadi nilai <strong>"Sebelum Perubahan / Semula"</strong>.
                </small>
            </div>

            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label asp-for="NomorUsulan" class="form-label"></label>
                    <input asp-for="NomorUsulan" class="form-control" placeholder="Otomatis digenerate jika kosong" />
                    <span asp-validation-for="NomorUsulan" style="color: var(--danger); font-size: 0.75rem;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TanggalUsulan" class="form-label"></label>
                    <input asp-for="TanggalUsulan" class="form-control" type="date" />
                    <span asp-validation-for="TanggalUsulan" style="color: var(--danger); font-size: 0.75rem;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label asp-for="Program" class="form-label"></label>
                    <input asp-for="Program" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Kegiatan" class="form-label"></label>
                    <input asp-for="Kegiatan" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="SubKegiatan" class="form-label"></label>
                <input asp-for="SubKegiatan" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Keterangan" class="form-label"></label>
                <textarea asp-for="Keterangan" class="form-control" rows="2" placeholder="Catatan atau pengantar usulan"></textarea>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Inisiasi Dokumen & Buka Canvas
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleDpaInduk() {
        var jenis = document.getElementById('selectJenisAnggaran').value;
        var group = document.getElementById('groupDpaInduk');
        if (jenis === 'PERUBAHAN') {
            group.style.display = 'block';
        } else {
            group.style.display = 'none';
        }
    }
    document.addEventListener('DOMContentLoaded', toggleDpaInduk);
</script>
