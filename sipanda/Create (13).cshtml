@model Sipanda.Models.Entities.MasterRekening
@{
    ViewData["Title"] = "Tambah Master Rekening";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Tambah Rekening Retribusi</h2>
        <p class="page-subtitle">Masukkan kode rekening dan uraian pendapatan baru</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="KodeRekening" class="form-label"></label>
                <input asp-for="KodeRekening" class="form-control" placeholder="Contoh: 4.1.02.01.01.0001" />
                <span asp-validation-for="KodeRekening" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NamaRekening" class="form-label"></label>
                <input asp-for="NamaRekening" class="form-control" placeholder="Contoh: Retribusi Pelayanan Kesehatan - Puskesmas" />
                <span asp-validation-for="NamaRekening" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Simpan Rekening
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
