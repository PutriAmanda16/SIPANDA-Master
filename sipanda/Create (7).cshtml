@model Sipanda.Models.Entities.MasterKomponen
@{
    ViewData["Title"] = "Tambah Layanan / Tindakan";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Tambah Layanan / Tindakan Medis</h2>
        <p class="page-subtitle">Masukkan nama layanan medis dan pilih kategori yang sesuai</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="KategoriId" class="form-label"></label>
                <select asp-for="KategoriId" class="form-select" asp-items="ViewBag.KategoriId">
                    <option value="">-- Pilih Kategori Layanan --</option>
                </select>
                <span asp-validation-for="KategoriId" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NamaKomponen" class="form-label"></label>
                <input asp-for="NamaKomponen" class="form-control" placeholder="Contoh: Pemeriksaan Hemoglobin, USG Abdomen, dll" />
                <span asp-validation-for="NamaKomponen" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Satuan" class="form-label"></label>
                <input asp-for="Satuan" class="form-control" placeholder="Contoh: Per Layanan, Per Sampel, Per Hari, Per Tindakan" />
                <span asp-validation-for="Satuan" style="color: var(--danger); font-size: 0.75rem;"></span>
            </div>

            <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle-fill"></i> Simpan Layanan
                </button>
                <a asp-action="Index" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>
