@model IEnumerable<Sipanda.Models.Entities.MasterRekening>
@{
    ViewData["Title"] = "Master Rekening";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Master Rekening Pendapatan</h2>
        <p class="page-subtitle">Kelola kode dan uraian rekening retribusi daerah</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Rekening
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="bi bi-cash-stack" style="color: var(--primary);"></i> Daftar Rekening Retribusi</h3>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 200px;">Kode Rekening</th>
                        <th>Nama / Uraian Rekening</th>
                        <th>Faskes Terkait</th>
                        <th style="width: 150px; text-align: center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td><span class="badge badge-primary">@item.KodeRekening</span></td>
                            <td style="font-weight: 600; color: #0f172a;">@item.NamaRekening</td>
                            <td>
                                @if (item.FaskesList.Any())
                                {
                                    @foreach (var f in item.FaskesList)
                                    {
                                        <span class="badge badge-secondary" style="margin-right: 0.25rem;">@f.NamaFaskes</span>
                                    }
                                }
                                else
                                {
                                    <span style="color: #94a3b8; font-size: 0.8rem;">- Belum ada faskes -</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; gap: 0.35rem;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus rekening ini?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" title="Hapus">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
